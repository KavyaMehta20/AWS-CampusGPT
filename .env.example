# CampusGPT Configuration (.env.example)
# Copy this file to .env and fill in your GEMINI_API_KEY.

# -----------------------------------------------------------------------------
# 1. API Keys & Gemini Settings
# -----------------------------------------------------------------------------
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini generation model (active workhorse model with fast latency)
GEMINI_MODEL=gemini-2.5-flash

# Gemini embedding model (primary active text embedding model)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# -----------------------------------------------------------------------------
# 2. University & Application Settings
# -----------------------------------------------------------------------------
# University name displayed in the UI and used by the system prompt
UNIVERSITY_NAME=RIT Dubai

# Generation sampling temperature (0.0 to 1.0, lower is more deterministic)
TEMPERATURE=0.2

# Maximum allowable characters for user question (Input Guardrail)
MAX_QUESTION_CHARS=500

# Whether to include the full debug trace in /chat responses
INCLUDE_TRACE=true

# Allowed CORS origins for frontend access (comma-separated or * for local dev)
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# 3. Chunking Settings (Step 1)
# -----------------------------------------------------------------------------
# Chunking strategy: 'overlapping', 'fixed', 'structure', or 'semantic'
CHUNKING_STRATEGY=overlapping

# Target chunk size in approximated tokens (approx words * 1.3)
CHUNK_SIZE=500

# Token overlap between consecutive chunks
CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# 4. Retrieval & Vector Store Settings (Steps 3 & 4)
# -----------------------------------------------------------------------------
# Vector store backend: 'chroma' (local persistent db) or 'faiss' (in-memory/Lambda)
VECTOR_STORE=chroma

# Number of initial candidate chunks retrieved from the vector store
TOP_K_CANDIDATES=20

# Final number of top chunks passed to generation after reranking
FINAL_K=5

# Minimum cosine relevance score threshold (0.0 to 1.0)
MIN_RELEVANCE=0.25

# Reranking strategy: 'lexical', 'none', 'gemini', or 'cross_encoder'
RERANKER=lexical

# -----------------------------------------------------------------------------
# 5. MCP Settings (Step MCP)
# -----------------------------------------------------------------------------
# Enable Model Context Protocol tools for course & calendar lookups
ENABLE_MCP=false
